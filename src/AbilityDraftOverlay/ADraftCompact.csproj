<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 gives access to the built-in Windows OCR (Windows.Media.Ocr) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AbilityDraftOverlay</RootNamespace>
    <AssemblyName>AbilityDraftOverlay</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Release version: shown in the window title and compared with the latest GitHub release. Tag releases as v0.1.0. -->
    <Version>0.1.1</Version>
    <!-- Single-file release: dotnet publish -c Release -r win-x64 (see README / publish.ps1) -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <!-- Needs the .NET 10 Desktop Runtime on the user's PC; keeps the exe small. -->
    <SelfContained>false</SelfContained>
    <!-- Precompiled code: faster start-up. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embedded so the release is one exe; layout.1920x1080.json next to the exe still overrides it. -->
    <EmbeddedResource Include="Layouts\ability_draft_1920x1080.json" LogicalName="ability_draft_1920x1080.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
  </ItemGroup>
</Project>
