<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF171A21" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF232833" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFB3BAC7" />

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="MinWidth" Value="720" />
        <Setter Property="MinHeight" Value="420" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
</ResourceDictionary>
