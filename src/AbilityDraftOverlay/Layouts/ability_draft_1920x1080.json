{
  // Раскладка экрана Ability Draft для 1920x1080, измеренная по реальному скриншоту (22-й раунд выбора).
  // Все x/y/w/h - в пикселях кадра 1920x1080. Если ваш экран отличается - см. раздел «Калибровка» в README.
  //
  // Номер игрока = row * (число колонок) + индекс колонки + 1:
  //   ряд 0: колонка 0 = игрок 1, колонка 1 = игрок 2; ряд 1: игрок 3, 4; ... ряд 4: игрок 9, 10.
  // Левая колонка - команда 1 (нечётные игроки), правая - команда 2 (чётные).
  //
  // Слоты способностей: 0, 1, 2 - обычные способности, 3 - ультимейт (в игре ультимейт всегда в последнем слоте).
  // Герой нарисован слева у команды 1 и справа у команды 2, поэтому "hero" задан для каждой колонки отдельно;
  // слоты способностей у обеих команд идут слева направо в одном порядке.

  "referenceWidth": 1920,
  "referenceHeight": 1080,
  "calibrated": true,

  "rows": 5,
  "rowPitch": 168,

  // x,y - левый верхний угол панели игрока в первом ряду; слоты заданы относительно него.
  "columns": [
    {
      "team": 1, "x": 141, "y": 147,
      // Часть арта героя без имени, ника и мелких иконок (лицо/верх фигуры).
      "hero": { "x": 2, "y": 3, "w": 81, "h": 100 },
      // Строка с именем героя ("LUNA" / "NO HERO"), читается через OCR; ник игрока ниже в полосу не попадает.
      "heroName": { "x": 80, "y": 4, "w": 260, "h": 30 },
      "abilities": [
        { "x": 78,  "y": 90, "w": 54, "h": 54 },
        { "x": 138, "y": 90, "w": 54, "h": 54 },
        { "x": 198, "y": 90, "w": 54, "h": 54 },
        { "x": 258, "y": 90, "w": 54, "h": 54 }
      ]
    },
    {
      "team": 2, "x": 1461, "y": 147,
      "hero": { "x": 241, "y": 3, "w": 76, "h": 100 },
      // У команды 2 имя выровнено по правому краю и частично лежит поверх арта героя.
      "heroName": { "x": 0, "y": 4, "w": 320, "h": 30 },
      "abilities": [
        { "x": 6,   "y": 90, "w": 54, "h": 54 },
        { "x": 66,  "y": 90, "w": 54, "h": 54 },
        { "x": 126, "y": 90, "w": 54, "h": 54 },
        { "x": 186, "y": 90, "w": 54, "h": 54 }
      ]
    }
  ],

  // Запасные значения для колонок без собственных "hero"/"abilities".
  "hero": { "x": 2, "y": 3, "w": 81, "h": 100 },
  "abilities": [
    { "x": 78,  "y": 90, "w": 54, "h": 54 },
    { "x": 138, "y": 90, "w": 54, "h": 54 },
    { "x": 198, "y": 90, "w": 54, "h": 54 },
    { "x": 258, "y": 90, "w": 54, "h": 54 }
  ],

  "matching": {
    "minScore": 0.55,          // не проверено на реальных иконках - подбирается по оценкам из отладочного изображения
    "minMargin": 0.10,
    "emptyInset": 6,           // проверено на скриншоте: пустые способности mean <= 13, заполненные >= 67
    "abilityEmptyMaxMean": 35,
    "heroEmptyMaxStdDev": 40,  // проверено на скриншоте: "NO HERO" std 15-29, настоящий арт 50-67
    "inset": 3,
    "shiftPx": 2,

    // Герои: арт в карточке анимирован, поэтому он НЕ сравнивается со статичными картинками.
    // "auto" - читать имя героя через встроенный OCR Windows, а если он недоступен - сравнивать картинки;
    // "ocr" - только OCR (иначе ошибка); "image" - только картинки (ненадёжно).
    "heroSource": "auto",
    "ocrLanguage": "en-US",     // клиент игры должен быть на английском
    "heroNameMinScore": 0.70,
    "heroNameMinMargin": 0.12,
    "boardMinCards": 8          // кадр считается доской драфта, если имя героя или NO HERO прочитано минимум на 8 из 10 карточек
  }
}
