{
  // Ability Draft layout for 1920x1080, measured from a real screenshot (pick round 22).
  // All x/y/w/h values are pixels in a 1920x1080 frame. If your screen differs, see the layout calibration notes in the README.
  //
  // Player number = row * (number of columns) + column index + 1:
  //   row 0: column 0 = player 1, column 1 = player 2; row 1 = players 3 and 4; ... row 4 = players 9 and 10.
  // Left column = team 1 (odd-numbered players); right column = team 2 (even-numbered players).
  //
  // Ability slots: 0, 1, 2 are regular abilities; 3 is the ultimate (the ultimate is always the last slot in-game).
  // The hero is shown on the left for team 1 and on the right for team 2, so "hero" is configured separately for each column;
  // ability slots for both teams use the same left-to-right order.

  "referenceWidth": 1920,
  "referenceHeight": 1080,
  "calibrated": true,

  "rows": 5,
  "rowPitch": 168,

  // x,y are the top-left corner of the player panel in the first row; slots are positioned relative to it.
  "columns": [
    {
      "team": 1, "x": 141, "y": 147,
      // Hero artwork area excluding the name, player nickname, and small icons (face/upper body).
      "hero": { "x": 2, "y": 3, "w": 81, "h": 100 },
      // Hero name line ("LUNA" / "NO HERO"), read using OCR; the player nickname below is outside this region.
      "heroName": { "x": 80, "y": 4, "w": 260, "h": 30 },
      "abilities": [
        { "x": 78,  "y": 90, "w": 54, "h": 54 },
        { "x": 138, "y": 90, "w": 54, "h": 54 },
        { "x": 198, "y": 90, "w": 54, "h": 54 },
        { "x": 258, "y": 90, "w": 54, "h": 54 }
      ]
    },
    {
      "team": 2, "x": 1461, "y": 147,
      "hero": { "x": 241, "y": 3, "w": 76, "h": 100 },
      // For team 2, the name is right-aligned and partially overlays the hero artwork.
      "heroName": { "x": 0, "y": 4, "w": 320, "h": 30 },
      "abilities": [
        { "x": 6,   "y": 90, "w": 54, "h": 54 },
        { "x": 66,  "y": 90, "w": 54, "h": 54 },
        { "x": 126, "y": 90, "w": 54, "h": 54 },
        { "x": 186, "y": 90, "w": 54, "h": 54 }
      ]
    }
  ],

  // Fallback values for columns without their own "hero"/"abilities".
  "hero": { "x": 2, "y": 3, "w": 81, "h": 100 },
  "abilities": [
    { "x": 78,  "y": 90, "w": 54, "h": 54 },
    { "x": 138, "y": 90, "w": 54, "h": 54 },
    { "x": 198, "y": 90, "w": 54, "h": 54 },
    { "x": 258, "y": 90, "w": 54, "h": 54 }
  ],

  "matching": {
    "minScore": 0.55,          // not validated on real icons; tune using scores in the debug image
    "minMargin": 0.10,
    "emptyInset": 6,
    // An ability slot is empty when its center is flat (pooled std-dev below this). Brightness is NOT used:
    // dark icons would be taken for empty slots. Empty boxes measure ~5-20, real icons 35+; the debug image prints "s=" per empty slot.
    "abilityEmptyMaxStdDev": 25,
    "heroEmptyMaxStdDev": 40,  // checked against a screenshot: "NO HERO" std 15-29, real artwork 50-67
    "inset": 3,
    "shiftPx": 2,

    // Heroes: card artwork is animated, so it is NOT compared with static images.
    // "auto" reads hero names using built-in Windows OCR, falling back to image matching if OCR is unavailable;
    // "ocr" uses OCR only (otherwise an error); "image" uses image matching only (less reliable).
    "heroSource": "auto",
    "ocrLanguage": "en-US",     // the game client must be in English
    "heroNameMinScore": 0.70,
    "heroNameMinMargin": 0.12,
    "boardMinCards": 8          // a frame is considered a draft board if a hero name or NO HERO is read on at least 8 of 10 cards
  }
}
