{
  // ВНИМАНИЕ: координаты ниже - ПРИМЕРНЫЕ заглушки, не измеренные на реальном экране Ability Draft.
  // Пока calibrated = false, приложение предупреждает об этом. Порядок калибровки:
  //   1) запустите распознавание на своём скриншоте 1920x1080;
  //   2) откройте %LocalAppData%\AbilityDraftOverlay\Debug\last_recognition.png - на нём нарисованы все слоты;
  //   3) поправьте числа и положите файл как %LocalAppData%\AbilityDraftOverlay\layout.1920x1080.json
  //      (он имеет приоритет над этим файлом, пересборка не нужна); повторяйте до совпадения рамок с иконками;
  //   4) поставьте "calibrated": true.
  //
  // Все x/y/w/h - в пикселях кадра 1920x1080.
  // Номер игрока = row * (число колонок) + индекс колонки + 1:
  //   ряд 0: колонка 0 = игрок 1, колонка 1 = игрок 2; ряд 1: игрок 3, 4; и т.д.

  "referenceWidth": 1920,
  "referenceHeight": 1080,
  "calibrated": false,

  "rows": 5,
  "rowPitch": 120,

  // x,y - левый верхний угол ячейки игрока в первом ряду; слоты ниже заданы относительно него.
  // Если колонка зеркальна, добавьте ей собственные "hero" и "abilities".
  "columns": [
    { "team": 1, "x": 60,   "y": 250 },
    { "team": 2, "x": 1000, "y": 250 }
  ],

  "hero": { "x": 0, "y": 0, "w": 150, "h": 84 },

  // Один слот на каждую выбираемую способность (сейчас 5 - как в описании задачи).
  "abilities": [
    { "x": 160, "y": 10, "w": 64, "h": 64 },
    { "x": 232, "y": 10, "w": 64, "h": 64 },
    { "x": 304, "y": 10, "w": 64, "h": 64 },
    { "x": 376, "y": 10, "w": 64, "h": 64 },
    { "x": 448, "y": 10, "w": 64, "h": 64 }
  ],

  "matching": {
    "minScore": 0.55,
    "minMargin": 0.10,
    "emptyStdDev": 8.0,
    "inset": 2,
    "shiftPx": 2
  }
}
