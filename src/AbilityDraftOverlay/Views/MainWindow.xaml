<Window
    x:Class="AbilityDraftOverlay.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ability Draft Overlay" Width="980" Height="620" MinWidth="700" MinHeight="420"
    Background="#FF171A21" FontFamily="Segoe UI" Foreground="#FFF2F4F8"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF303744" />
            <Setter Property="Foreground" Value="#FFF2F4F8" />
            <Setter Property="BorderBrush" Value="#FF485263" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FF414B5C" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FF202630" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- Shown only when the startup checks failed; it sits outside the disabled content so it stays readable. -->
    <Border Margin="12,12,12,0" Padding="12,9" Background="#FF4A2F1C" BorderBrush="#FFE0A04A" BorderThickness="1" CornerRadius="7"
            Visibility="{Binding EnvironmentBannerVisibility}">
        <StackPanel>
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FFFFC76B" Text="⚠ The application cannot work reliably on this system" />
            <TextBlock Margin="0,6,0,0" Foreground="#FFF2F4F8" TextWrapping="Wrap" Text="{Binding EnvironmentWarning}" />
            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#FFC9B79A" Text="The window is disabled. Fix the problems above and restart the application." />
        </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="12" IsEnabled="{Binding IsEnvironmentOk}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="8" Margin="0,0,0,10" Background="#FF232833" CornerRadius="7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="5,0,0,0" Command="{Binding ToggleTrackingCommand}" Content="{Binding TrackingButtonText}"
                        ToolTip="Automatically capture Dota 2 and recognize picks" />
                    <Button Margin="5,0,0,0" Command="{Binding ToggleOverlayCommand}" Content="{Binding OverlayButtonText}"
                        ToolTip="Show or hide the transparent in-game overlay" />
                    <Button Margin="5,0,0,0" Command="{Binding OpenOverlaySettingsCommand}" Content="⚙ Overlay"
                        ToolTip="Configure overlay position, size, and appearance" />
                    <Button Margin="5,0,0,0" Command="{Binding DownloadResourcesCommand}" Content="⇩ Assets"
                        ToolTip="Download hero and ability icons" />
                    <Button Margin="5,0,0,0" Command="{Binding ClearEventsCommand}" Content="⌫ Clear log" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Ability Draft Overlay" />
                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#FF9EA9BA" Text="{Binding SessionText}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Padding="10" Background="#FF232833" CornerRadius="7">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,8" FontSize="15" FontWeight="SemiBold" Text="Event log" />
                <ListBox Grid.Row="1" Padding="4" Background="#FF171A21" BorderBrush="#FF3A414E"
                    Foreground="#FFF2F4F8" ItemsSource="{Binding Events}">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border Padding="5,7" BorderBrush="#FF343B47" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Top" Foreground="#FF9EA9BA" FontSize="11"
                                    Text="{Binding DetectedAt, StringFormat={}{0:HH:mm:ss}}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top" Foreground="#FF9EA9BA"
                                    FontSize="11" Text="{Binding Kind}" />
                            </Grid>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="8,6" Background="#FF202630" BorderBrush="#FF343B47" BorderThickness="1" CornerRadius="5">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#FFD0D6E0" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                <!-- Countdown to the next screenshot while tracking, assets summary otherwise. MinWidth keeps the bar from shifting the status text. -->
                <TextBlock Grid.Column="1" Margin="12,0,0,0" MinWidth="250" TextAlignment="Right" VerticalAlignment="Center" Foreground="#FF9EA9BA" FontSize="11" Text="{Binding RightStatusText}" />
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
