<Window x:Class="AbilityDraftOverlay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ability Draft Overlay" Width="1120" Height="760"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="#FF171A21" Foreground="#FFF2F4F8" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Text="Ability Draft Overlay"/>
                <TextBlock Margin="0,5,0,0" Foreground="#FFB3BAC7"
                           Text="Тестирование кадров и загрузка ресурсов Dota 2 · без OCR и AI"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Загрузить ресурсы" Command="{Binding DownloadResourcesCommand}"
                   />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FF232833" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Текущий кадр" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Выбрать следующий кадр..." Click="SelectFrameButton_Click"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#FF101216" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="FrameImage" Stretch="Uniform"/>
                            <TextBlock x:Name="EmptyFrameText" Text="Выберите файл скриншота (PNG, JPG, BMP)"
                                       Foreground="#FFB3BAC7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="20"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#FF232833" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="События" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Events}" Background="#FF171A21"
                             Foreground="#FFF2F4F8" BorderBrush="#FF3A414E" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FF343B47" BorderThickness="0,0,0,1" Padding="5,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#FFB3BAC7">
                                            <Run Text="{Binding DetectedAt, StringFormat={}{0:HH:mm:ss}}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Kind}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Foreground="#FFB3BAC7" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Очистить события" Command="{Binding ClearEventsCommand}"/>
                <Button Content="Выход" Click="ExitButton_Click" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
