<Window x:Class="ADraftCompact.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Settings"/>
        <StackPanel Grid.Row="1" Margin="0,20,0,16">
            <TextBlock Text="Theme"/>
            <ComboBox Margin="0,6,0,16" SelectedValue="{Binding Theme, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="System"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>
            <TextBlock Text="Target resolution (initial setup)"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                <TextBox Width="100" Text="{Binding TargetScreenWidth, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="8,5" Text="×"/>
                <TextBox Width="100" Text="{Binding TargetScreenHeight, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding StatusText}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}"/>
            <Button Content="Close" IsCancel="True" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
