<Window
    x:Class="ADraftCompact.Views.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Updating" Width="380" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
        <ProgressBar x:Name="Bar" Height="16" Margin="0,10,0,6" Minimum="0" Maximum="100" />
        <TextBlock x:Name="SizeText" Foreground="Gray" Text="Connecting..." />
    </StackPanel>
</Window>
