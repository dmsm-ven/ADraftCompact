<Window
    x:Class="ADraftCompact.Views.OverlaySettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Overlay Settings"
    Width="520"
    MinWidth="460"
    MinHeight="400"
    Background="#FF171A21"
    FontFamily="Segoe UI"
    Foreground="#FFF2F4F8"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,8,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#FF303744" />
            <Setter Property="Foreground" Value="#FFF2F4F8" />
            <Setter Property="BorderBrush" Value="#FF485263" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="OrientationTile" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Width="120" Height="84" CornerRadius="4" Background="#FF232833"
                                BorderBrush="#FF485263" BorderThickness="2" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="DeepSkyBlue" />
                                <Setter TargetName="Frame" Property="Background" Value="#FF1E3A52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Position" />
                <DockPanel Margin="0,0,0,8">
                    <Button
                        x:Name="PositionButton"
                        Click="PositionButton_Click"
                        Content="Move overlay"
                        DockPanel.Dock="Right" />
                    <TextBlock
                        x:Name="PositionStatus"
                        Foreground="#FFB5C0D0"
                        Text="Position saved" />
                </DockPanel>
                <TextBlock
                    Margin="0,5,0,4"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Orientation" />
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <RadioButton x:Name="VerticalTile" GroupName="Orientation" Style="{StaticResource OrientationTile}" IsChecked="True">
                        <StackPanel>
                            <Border Width="44" Height="16" Margin="0,0,0,4" Background="#FF3FA66B" CornerRadius="2" />
                            <Border Width="44" Height="16" Background="#FFC2523F" CornerRadius="2" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#FFB5C0D0" Text="Vertical" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="HorizontalTile" GroupName="Orientation" Style="{StaticResource OrientationTile}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="30" Height="32" Margin="0,0,4,0" Background="#FF3FA66B" CornerRadius="2" />
                                <Border Width="30" Height="32" Background="#FFC2523F" CornerRadius="2" />
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="#FFB5C0D0" Text="Horizontal" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <TextBlock
                    Margin="0,5,0,4"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Hotkey" />
                <DockPanel Margin="0,0,0,8">
                    <TextBox
                        x:Name="HotkeyBox"
                        Width="160"
                        Margin="8,0,0,0"
                        Padding="6,4"
                        Background="#FF232833"
                        BorderBrush="#FF485263"
                        Cursor="Arrow"
                        DockPanel.Dock="Right"
                        Foreground="#FFF2F4F8"
                        GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                        IsReadOnly="True"
                        IsReadOnlyCaretVisible="False"
                        LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                        PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                        TextAlignment="Center"
                        ToolTip="Click the field and press a key combination" />
                    <TextBlock
                        x:Name="HotkeyHint"
                        Foreground="#FFB5C0D0"
                        Text="Recognize abilities (works inside the game)"
                        TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock
                    Margin="0,5,0,4"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Appearance" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="165" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Background color" />
                    <Button
                        x:Name="OverlayColorButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Height="28"
                        Margin="0,3"
                        HorizontalAlignment="Right"
                        Click="OverlayColorButton_Click"
                        Content="Choose color" />
                    <TextBlock Grid.Row="2" Text="Background opacity" />
                    <Slider
                        x:Name="OpacitySlider"
                        Grid.Row="2"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="100"
                        Minimum="0"
                        TickFrequency="1"
                        Value="0" />
                    <TextBlock
                        x:Name="OpacityValue"
                        Grid.Row="2"
                        Grid.Column="2"
                        Text="0%"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="3" Text="Overall opacity" ToolTip="Icons, borders and team names" />
                    <Slider
                        x:Name="ContentOpacitySlider"
                        Grid.Row="3"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="100"
                        Minimum="10"
                        TickFrequency="1"
                        Value="100" />
                    <TextBlock
                        x:Name="ContentOpacityValue"
                        Grid.Row="3"
                        Grid.Column="2"
                        Text="100%"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="4" Text="Icon size" />
                    <Slider
                        x:Name="IconSizeSlider"
                        Grid.Row="4"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="150"
                        Minimum="16"
                        TickFrequency="1"
                        Value="40" />
                    <TextBlock
                        x:Name="IconSizeValue"
                        Grid.Row="4"
                        Grid.Column="2"
                        Text="40 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="1" Text="Icon border color" />
                    <Button
                        x:Name="BorderColorButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Height="28"
                        Margin="0,3"
                        HorizontalAlignment="Right"
                        Click="BorderColorButton_Click"
                        Content="Choose color" />
                    <TextBlock Grid.Row="5" Text="Border thickness" />
                    <Slider
                        x:Name="BorderSizeSlider"
                        Grid.Row="5"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="8"
                        Minimum="0"
                        TickFrequency="1"
                        Value="1" />
                    <TextBlock
                        x:Name="BorderSizeValue"
                        Grid.Row="5"
                        Grid.Column="2"
                        Text="1 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="7" Text="Hero spacing" />
                    <Slider
                        x:Name="HeroGapSlider"
                        Grid.Row="7"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="40"
                        TickFrequency="1"
                        Value="4" />
                    <TextBlock
                        x:Name="HeroGapValue"
                        Grid.Row="7"
                        Grid.Column="2"
                        Text="4 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="8" Text="Ability spacing" />
                    <Slider
                        x:Name="AbilityGapSlider"
                        Grid.Row="8"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="40"
                        TickFrequency="1"
                        Value="4" />
                    <TextBlock
                        x:Name="AbilityGapValue"
                        Grid.Row="8"
                        Grid.Column="2"
                        Text="4 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="6" Text="Player row spacing" />
                    <Slider
                        x:Name="RowGapSlider"
                        Grid.Row="6"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="80"
                        TickFrequency="1"
                        Value="4" />
                    <TextBlock
                        x:Name="RowGapValue"
                        Grid.Row="6"
                        Grid.Column="2"
                        Text="4 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="9" Text="Team spacing" />
                    <Slider
                        x:Name="TeamGapSlider"
                        Grid.Row="9"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="400"
                        TickFrequency="5"
                        Value="30" />
                    <TextBlock
                        x:Name="TeamGapValue"
                        Grid.Row="9"
                        Grid.Column="2"
                        Text="30 px"
                        TextAlignment="Right" />
                    <CheckBox
                        x:Name="ShowNamesCheckBox"
                        Grid.Row="10"
                        Grid.ColumnSpan="3"
                        Margin="0,7,0,4"
                        Content="Show Radiant / Dire labels"
                        Foreground="White" />
                    <CheckBox
                        x:Name="RoundBordersCheckBox"
                        Grid.Row="11"
                        Grid.ColumnSpan="3"
                        Margin="0,3,0,4"
                        Content="Round icon borders"
                        Foreground="White" />
                </Grid>
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="11"
                    Foreground="#FF9EA9BA"
                    Text="Changes are applied to the overlay immediately. Settings are saved when this window closes."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Command="{Binding DownloadResourcesCommand}"
                Content="Download assets"
                ToolTip="Download hero and ability icons" />
            <TextBlock
                Grid.Column="1"
                Margin="10,0"
                FontSize="11"
                Foreground="#FF9EA9BA"
                Text="{Binding AssetsStatusText}"
                TextTrimming="CharacterEllipsis" />
            <Button
                Grid.Column="2"
                MinWidth="90"
                Click="CloseButton_Click"
                Content="Close" />
        </Grid>
    </Grid>
</Window>
