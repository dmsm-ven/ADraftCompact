<Window
    x:Class="AbilityDraftOverlay.Views.OverlaySettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Настройки оверлея"
    SizeToContent="WidthAndHeight"
    MinWidth="400"
    MinHeight="500"
    Background="#FF171A21"
    FontFamily="Segoe UI"
    Foreground="#FFF2F4F8"
    WindowStartupLocation="CenterOwner" Height="489">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,8,6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#FF303744" />
            <Setter Property="Foreground" Value="#FFF2F4F8" />
            <Setter Property="BorderBrush" Value="#FF485263" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Позиция на экране" />
                <DockPanel Margin="0,0,0,8">
                    <Button
                        x:Name="PositionButton"
                        Click="PositionButton_Click"
                        Content="Переместить оверлей"
                        DockPanel.Dock="Right" />
                    <TextBlock
                        x:Name="PositionStatus"
                        Foreground="#FFB5C0D0"
                        Text="Позиция сохранена" />
                </DockPanel>
                <TextBlock
                    Margin="0,5,0,4"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Внешний вид" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="165" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Цвет фона" />
                    <Button
                        x:Name="OverlayColorButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="122"
                        Height="28"
                        MinWidth="122"
                        Margin="0,3"
                        HorizontalAlignment="Right"
                        Click="OverlayColorButton_Click"
                        Content="Выбрать цвет" />
                    <TextBlock Grid.Row="2" Text="Непрозрачность фона" />
                    <Slider
                        x:Name="OpacitySlider"
                        Grid.Row="2"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="100"
                        Minimum="0"
                        TickFrequency="1"
                        Value="0" />
                    <TextBlock
                        x:Name="OpacityValue"
                        Grid.Row="2"
                        Grid.Column="2"
                        Text="0%"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="3" Text="Размер иконок" />
                    <Slider
                        x:Name="IconSizeSlider"
                        Grid.Row="3"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="180"
                        Minimum="15"
                        TickFrequency="5"
                        Value="40" />
                    <TextBlock
                        x:Name="IconSizeValue"
                        Grid.Row="3"
                        Grid.Column="2"
                        Text="40 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="1" Text="Цвет рамки иконок" />
                    <Button
                        x:Name="BorderColorButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="122"
                        Height="28"
                        MinWidth="122"
                        Margin="0,3"
                        HorizontalAlignment="Right"
                        Click="BorderColorButton_Click"
                        Content="Выбрать цвет" />
                    <TextBlock Grid.Row="4" Text="Толщина рамки" />
                    <Slider
                        x:Name="BorderSizeSlider"
                        Grid.Row="4"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="8"
                        Minimum="0"
                        TickFrequency="1"
                        Value="1" />
                    <TextBlock
                        x:Name="BorderSizeValue"
                        Grid.Row="4"
                        Grid.Column="2"
                        Text="1 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="5" Text="Отступ между игроками" />
                    <Slider
                        x:Name="RowGapSlider"
                        Grid.Row="5"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="80"
                        TickFrequency="1"
                        Value="4" />
                    <TextBlock
                        x:Name="RowGapValue"
                        Grid.Row="5"
                        Grid.Column="2"
                        Text="4 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="6" Text="Отступ после героя" />
                    <Slider
                        x:Name="HeroGapSlider"
                        Grid.Row="6"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="40"
                        TickFrequency="1"
                        Value="4" />
                    <TextBlock
                        x:Name="HeroGapValue"
                        Grid.Row="6"
                        Grid.Column="2"
                        Text="4 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="7" Text="Отступ способностей" />
                    <Slider
                        x:Name="AbilityGapSlider"
                        Grid.Row="7"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="40"
                        TickFrequency="1"
                        Value="4" />
                    <TextBlock
                        x:Name="AbilityGapValue"
                        Grid.Row="7"
                        Grid.Column="2"
                        Text="4 px"
                        TextAlignment="Right" />
                    <TextBlock Grid.Row="8" Text="Отступ между командами" />
                    <Slider
                        x:Name="TeamGapSlider"
                        Grid.Row="8"
                        Grid.Column="1"
                        IsSnapToTickEnabled="True"
                        Maximum="400"
                        TickFrequency="5"
                        Value="30" />
                    <TextBlock
                        x:Name="TeamGapValue"
                        Grid.Row="8"
                        Grid.Column="2"
                        Text="30 px"
                        TextAlignment="Right" />
                    <CheckBox
                        x:Name="ShowNamesCheckBox"
                        Grid.Row="9"
                        Grid.ColumnSpan="3"
                        Margin="0,7,0,4"
                        Content="Показывать названия Radiant / Dire"
                        Foreground="White" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="90"
                Click="CloseButton_Click"
                Content="Закрыть" />
        </StackPanel>
    </Grid>
</Window>
