<Window x:Class="AbilityDraftOverlay.Views.ColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Выбор цвета" Width="300" Height="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FF202630" Foreground="#FFF2F4F8">
    <StackPanel Margin="12">
        <TextBlock Text="HEX-цвет (#AARRGGBB или #RRGGBB)" Margin="0,0,0,6"/>
        <TextBox x:Name="HexText" Padding="6" Text="#FF343A43"/>
        <Border x:Name="PreviewBorder" Height="36" Margin="0,8" BorderBrush="#FF707887" BorderThickness="1"/>
        <TextBlock Text="Быстрый выбор" Margin="0,2,0,5"/>
        <UniformGrid Columns="6" Rows="3">
            <Button Tag="#FF171A21" Click="Swatch_Click" Background="#FF171A21"/><Button Tag="#FF343A43" Click="Swatch_Click" Background="#FF343A43"/><Button Tag="#FF707887" Click="Swatch_Click" Background="#FF707887"/><Button Tag="#FFFFFFFF" Click="Swatch_Click" Background="#FFFFFFFF"/><Button Tag="#FF000000" Click="Swatch_Click" Background="#FF000000"/><Button Tag="#FFFF0000" Click="Swatch_Click" Background="#FFFF0000"/>
            <Button Tag="#FF00FF00" Click="Swatch_Click" Background="#FF00FF00"/><Button Tag="#FF0000FF" Click="Swatch_Click" Background="#FF0000FF"/><Button Tag="#FFFFFF00" Click="Swatch_Click" Background="#FFFFFF00"/><Button Tag="#FFFF00FF" Click="Swatch_Click" Background="#FFFF00FF"/><Button Tag="#FF00FFFF" Click="Swatch_Click" Background="#FF00FFFF"/><Button Tag="#FFFF8000" Click="Swatch_Click" Background="#FFFF8000"/>
            <Button Tag="#FF8B4513" Click="Swatch_Click" Background="#FF8B4513"/><Button Tag="#FF2E8B57" Click="Swatch_Click" Background="#FF2E8B57"/><Button Tag="#FF4169E1" Click="Swatch_Click" Background="#FF4169E1"/><Button Tag="#FF8A2BE2" Click="Swatch_Click" Background="#FF8A2BE2"/><Button Tag="#FFDC143C" Click="Swatch_Click" Background="#FFDC143C"/><Button Tag="#FF708090" Click="Swatch_Click" Background="#FF708090"/>
        </UniformGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Margin="0,0,8,0" Click="Cancel_Click" Content="Отмена"/><Button Click="Ok_Click" Content="Применить"/></StackPanel>
    </StackPanel>
</Window>
