<Window x:Class="AbilityDraftOverlay.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ability Draft Overlay" Width="268" Height="590" MinWidth="80" MinHeight="80"
    WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False">
    <Border x:Name="OverlayFrame" Padding="3" Background="{Binding OverlayBackground}"
            BorderBrush="{Binding OverlayBorderBrush}" BorderThickness="{Binding OverlayBorderThickness}" CornerRadius="3">
        <StackPanel>
            <TextBlock Margin="1,0,1,3" Foreground="#FFE8EDF5" FontSize="10" FontWeight="Bold"
                       Text="Radiant" Visibility="{Binding TeamNamesVisibility}" />
            <ItemsControl ItemsSource="{Binding RadiantRows}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="{Binding DataContext.PlayerRowMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="{Binding DataContext.HeroMargin, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent"
                                BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Hero}" Stretch="UniformToFill" /></Border>
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="{Binding DataContext.AbilityMargin, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Ability1}" Stretch="UniformToFill" /></Border>
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="{Binding DataContext.AbilityMargin, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Ability2}" Stretch="UniformToFill" /></Border>
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="{Binding DataContext.AbilityMargin, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Ability3}" Stretch="UniformToFill" /></Border>
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent" BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Ultimate}" Stretch="UniformToFill" /></Border>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="{Binding TeamGap}" Background="Transparent" />
            <TextBlock Margin="1,0,1,3" Foreground="#FFE8EDF5" FontSize="10" FontWeight="Bold"
                       Text="Dire" Visibility="{Binding TeamNamesVisibility}" />
            <ItemsControl ItemsSource="{Binding DireRows}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="{Binding DataContext.PlayerRowMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="{Binding DataContext.HeroMargin, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Hero}" Stretch="UniformToFill" /></Border>
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="{Binding DataContext.AbilityMargin, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Ability1}" Stretch="UniformToFill" /></Border>
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="{Binding DataContext.AbilityMargin, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Ability2}" Stretch="UniformToFill" /></Border>
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="{Binding DataContext.AbilityMargin, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Ability3}" Stretch="UniformToFill" /></Border>
                        <Border Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderBrush="{Binding DataContext.IconBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="{Binding DataContext.IconBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}"><Image Source="{Binding Ultimate}" Stretch="UniformToFill" /></Border>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
